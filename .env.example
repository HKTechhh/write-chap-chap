# Copy to .env on the droplet (cp .env.example .env) and fill in. Never commit .env.
# Local development uses backend/.env.example and frontend/.env.example instead.

# ---- Domain ----
DOMAIN=penspan.com
ACME_EMAIL=you@example.com

# ---- Django ----
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Demo accounts share a published password. Leave false on a real deployment.
SEED_DEMO=false

# ---- Postgres ----
# Use a hex password (openssl rand -hex 24) so it is safe inside DATABASE_URL.
POSTGRES_USER=penspan
POSTGRES_PASSWORD=
POSTGRES_DB=penspan

# ---- Sizing: 2 GB droplet values. For a 4 GB droplet use 3 / 2 / 2. ----
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
CELERY_CONCURRENCY=1

# ---- Platform economics ----
PLATFORM_FEE_PERCENT=12
PLATFORM_FEE_PERCENT_PRO=5
WITHDRAWAL_FEE_FLAT=50
LATE_FINE_PERCENT_PER_DAY=5
LATE_FINE_MAX_PERCENT=25
REVISION_WINDOW_HOURS=72
HUMANIZATION_PRICE_PER_PAGE=50
HUMANIZATION_WORDS_PER_PAGE=250
DOCUMENT_CHECK_PRICE=120
AI_CONTENT_THRESHOLD=20
PLAGIARISM_THRESHOLD=15

# ---- GPTZero ----
GPTZERO_API_KEY=

# ---- M-Pesa Daraja ----
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS URL for STK push results, e.g. https://penspan.com/api/payments/mpesa/callback/
MPESA_CALLBACK_URL=
# B2C payouts (see README). Keep disabled until tested in the Daraja sandbox.
MPESA_B2C_ENABLED=False
MPESA_B2C_AUTO_LIMIT=20000
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# ---- Flutterwave ----
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# ---- Support ----
WHATSAPP_SUPPORT_NUMBER=254700000000

# ---- File storage: DigitalOcean Spaces (recommended before real KYC uploads) ----
# Leave blank to store uploads on the droplet disk (test phase only, not access-controlled).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
AWS_S3_REGION_NAME=fra1
