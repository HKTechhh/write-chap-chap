# Normalise line endings so Windows checkouts don't break Linux deploys.
* text=auto

# Shell scripts MUST stay LF. A CRLF shebang fails on Linux with
# "bad interpreter: /usr/bin/env bash^M" — which is exactly what would
# happen to render-build.sh on deploy.
*.sh text eol=lf

# PowerShell scripts are Windows-side, keep CRLF.
*.ps1 text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
