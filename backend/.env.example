# ---- Core ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# ---- Database ----
# Leave DATABASE_URL blank to use SQLite for local development.
DATABASE_URL=
# Example Postgres: postgres://user:password@localhost:5432/penspan

# ---- Celery / Redis ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- Platform economics ----
PLATFORM_FEE_PERCENT=12
PLATFORM_FEE_PERCENT_PRO=5
WITHDRAWAL_FEE_FLAT=50
LATE_FINE_PERCENT_PER_DAY=5
LATE_FINE_MAX_PERCENT=25
REVISION_WINDOW_HOURS=72
HUMANIZATION_PRICE_PER_PAGE=50
HUMANIZATION_WORDS_PER_PAGE=250
DOCUMENT_CHECK_PRICE=120

# ---- Quality thresholds ----
AI_CONTENT_THRESHOLD=20
PLAGIARISM_THRESHOLD=15

# ---- GPTZero ----
GPTZERO_API_KEY=
GPTZERO_API_URL=https://api.gptzero.me/v2/predict/text

# ---- M-Pesa Daraja ----
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# B2C payouts: withdrawals sent straight to a writer's M-Pesa.
MPESA_B2C_ENABLED=False
MPESA_B2C_AUTO_LIMIT=20000
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR_NAME=
# Either the pre-encrypted credential, or the initiator password + Safaricom certificate path.
MPESA_SECURITY_CREDENTIAL=
MPESA_INITIATOR_PASSWORD=
MPESA_CERT_PATH=

# ---- Flutterwave ----
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# ---- Support ----
WHATSAPP_SUPPORT_NUMBER=254700000000
