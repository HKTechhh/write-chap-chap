# Builds the React app, then serves it with Caddy (automatic HTTPS).
# Build context is the repository root:  docker build -f deploy/Dockerfile.caddy .
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# The site and the API share one origin (Caddy proxies /api), so no API URL is needed.
# Baked into the bundle at build time.
ARG VITE_WHATSAPP_NUMBER=254700000000
ENV VITE_WHATSAPP_NUMBER=$VITE_WHATSAPP_NUMBER
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=web /web/dist /srv/www
